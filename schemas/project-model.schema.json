{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projectSourceHash", "modId", "features", "requirements", "acceptanceCriteria", "constraints", "nonGoals", "visualRequirements", "persistenceRequirements", "multiplayerRequirements", "references", "dependencies", "openQuestions", "retiredIds"],
  "properties": {
    "version": { "const": 1 },
    "projectSourceHash": { "type": "string" },
    "modId": { "type": "string" },
    "features": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "title", "purpose", "source"], "properties": {
      "id": { "type": "string" }, "title": { "type": "string" }, "purpose": { "type": "string" }, "source": { "$ref": "#/$defs/source" }
    }}},
    "requirements": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "featureId", "text", "source"], "properties": {
      "id": { "type": "string" }, "featureId": { "type": "string" }, "text": { "type": "string" }, "source": { "$ref": "#/$defs/source" }
    }}},
    "acceptanceCriteria": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "requirementId", "text", "source", "verification"], "properties": {
      "id": { "type": "string" }, "requirementId": { "type": "string" }, "text": { "type": "string" }, "source": { "$ref": "#/$defs/source" },
      "verification": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["method", "evidence"], "properties": { "method": { "enum": ["static", "unit", "gametest", "e2e", "visual", "persistence", "multiplayer"] }, "evidence": { "type": "string" } } } }
    }}},
    "constraints": { "$ref": "#/$defs/sourcedItems" },
    "nonGoals": { "$ref": "#/$defs/sourcedItems" },
    "visualRequirements": { "$ref": "#/$defs/sourcedItems" },
    "persistenceRequirements": { "$ref": "#/$defs/sourcedItems" },
    "multiplayerRequirements": { "$ref": "#/$defs/sourcedItems" },
    "references": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["summary", "location", "featureIds"], "properties": { "summary": { "type": "string" }, "location": { "type": "string" }, "featureIds": { "type": "array", "items": { "type": "string" } } } } },
    "dependencies": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "type": "string" }, "to": { "type": "string" } } } },
    "openQuestions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["question", "why", "alternatives", "projectEdit", "source"], "properties": { "question": { "type": "string" }, "why": { "type": "string" }, "alternatives": { "type": "array", "items": { "type": "string" } }, "projectEdit": { "type": "string" }, "source": { "$ref": "#/$defs/source" } } } },
    "retiredIds": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["section", "quote"], "properties": { "section": { "type": "string" }, "quote": { "type": "string" } } },
    "sourcedItems": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["text", "source"], "properties": { "text": { "type": "string" }, "source": { "$ref": "#/$defs/source" } } } }
  }
}
